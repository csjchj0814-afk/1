ometer.get_z()\n"]]},{"start1":387,"length1":85,"diffs":[[1,"    # 전체 가속도 계산 (sqrt 대신 단순 계산)\n    total_accel = (accel_x * accel_x + accel_y * accel_y + accel_z * accel_z) // 1000\n"]]},{"start1":510,"length1":729,"diffs":[[1,"    return total_accel\n\ndef calculate_target_velocity(accel_value):\n    \"\"\"\n    가속도에 따라 목표 속도 계산\n    \"\"\"\n    max_accel = 50\n   "]]}]},{"type":"added","filename":"test.ts","value":"// 테스트는 여기로 이동합니다; 이 패키지가 확장으로 사용될 때 컴파일되지 않을 것 입니다.\n"}]}],"snapshots":[{"timestamp":1789305837875,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"1\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1789307731685,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>","main.ts":"","README.md":"","main.py":"def on_forever():\n    pass\nbasic.forever(on_forever)\nimport serial\nimport time\nimport math\n\nclass RobotSpeedController:\n    def __init__(self, port='/dev/ttyUSB0', baudrate=9600):\n        \"\"\"\n        로봇 속도 제어 클래스 초기화\n        \n        Args:\n            port: 시리얼 포트\n            baudrate: 통신 속도\n        \"\"\"\n        self.ser = serial.Serial(port, baudrate, timeout=1)\n        self.prev_velocity = 0\n        self.current_velocity = 0\n        self.max_velocity = 255  # 모터 PWM 최대값\n        self.max_acceleration = 50  # 최대 가속도 (단위: units/s²)\n        \n    def read_acceleration(self):\n        \"\"\"\n        센서에서 가속도 값 읽기 (IMU 센서 가정)\n        \n        Returns:\n            float: 가속도 값\n        \"\"\"\n        if self.ser.in_waiting > 0:\n            data = self.ser.readline().decode().strip()\n            try:\n                acceleration = float(data)\n                return acceleration\n            except ValueError:\n                return 0\n        return 0\n    \n    def calculate_target_velocity(self, acceleration):\n        \"\"\"\n        가속도에 따라 목표 속도 계산\n        \n        가속도가 높을수록 속도를 낮춤 (안전성 증대)\n        \n        Args:\n            acceleration: 현재 가속도\n            \n        Returns:\n            float: 목표 속도\n        \"\"\"\n        # 가속도에 따른 속도 감소 비율\n        # 예: 가속도가 클수록 속도 감소\n        accel_ratio = abs(acceleration) / self.max_acceleration\n        accel_ratio = min(accel_ratio, 1.0)  # 0~1 범위로 제한\n        \n        # 가속도가 높으면 속도를 최대값에서 감소시킴\n        target_velocity = self.max_velocity * (1 - 0.5 * accel_ratio)\n        \n        return target_velocity\n    \n    def smooth_velocity_change(self, target_velocity, max_change_rate=10):\n        \"\"\"\n        속도를 부드럽게 변화시킴 (급격한 변화 방지)\n        \n        Args:\n            target_velocity: 목표 속도\n            max_change_rate: 한 번에 변할 수 있는 최대 속도 변화량\n            \n        Returns:\n            float: 실제 적용할 속도\n        \"\"\"\n        velocity_diff = target_velocity - self.current_velocity\n        \n        # 속도 변화 제한\n        if velocity_diff > max_change_rate:\n            self.current_velocity += max_change_rate\n        elif velocity_diff < -max_change_rate:\n            self.current_velocity -= max_change_rate\n        else:\n            self.current_velocity = target_velocity\n        \n        # 속도 범위 제한 (0 ~ max_velocity)\n        self.current_velocity = max(0, min(self.current_velocity, self.max_velocity))\n        \n        return self.current_velocity\n    \n    def apply_motor_speed(self, speed):\n        \"\"\"\n        모터에 속도값 적용\n        \n        Args:\n            speed: 모터 속도 (0~255)\n        \"\"\"\n        command = f\"SPEED:{int(speed)}\\n\"\n        self.ser.write(command.encode())\n        print(f\"모터 속도 설정: {int(speed)}\")\n    \n    def run(self, duration=60):\n        \"\"\"\n        로봇 속도 제어 실행\n        \n        Args:\n            duration: 실행 시간 (초)\n        \"\"\"\n        start_time = time.time()\n        \n        try:\n            while time.time() - start_time < duration:\n                # 1. 가속도 값 읽기\n                acceleration = self.read_acceleration()\n                \n                # 2. 목표 속도 계산\n                target_velocity = self.calculate_target_velocity(acceleration)\n                \n                # 3. 부드러운 속도 변화\n                actual_velocity = self.smooth_velocity_change(target_velocity)\n                \n                # 4. 모터에 속도 적용\n                self.apply_motor_speed(actual_velocity)\n                \n                # 상태 출력\n                print(f\"가속도: {acceleration:.2f} | 목표속도: {target_velocity:.1f} | 실제속도: {actual_velocity:.1f}\")\n                \n                time.sleep(0.1)  # 100ms 주기로 제어\n                \n        except KeyboardInterrupt:\n            print(\"\\n제어 중단\")\n        finally:\n            self.apply_motor_speed(0)  # 모터 정지\n            self.ser.close()\n\n# 사용 예제\nif __name__ == \"__main__\":\n    controller = RobotSpeedController(port='/dev/ttyUSB0')\n    controller.run(duration=60)","pxt.json":"{\n    \"name\": \"1\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\"\n}\n"}}],"shares":[],"lastSaveTime":1789308654710}