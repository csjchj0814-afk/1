alculate_target_velocity(acceleration)\n                \n                # 3. 부드러운 속도 변화\n                actual_velocity = self.smooth_velocity_change(target_velocity)\n                \n                # 4. 모터에 속도 적용\n                self.apply_motor_speed(actual_velocity)\n                \n                # 상태 출력\n                print(f\"가속도: {acceleration:.2f} | 목표속도: {target_velocity:.1f} | 실제속도: {actual_velocity:.1f}\")\n                \n                time.sleep(0.1)  # 100ms 주기로 제어\n                \n        except KeyboardInterrupt:\n            print(\"\\n제어 중단\")\n        finally:\n            self.apply_motor_speed(0)  # 모터 정지\n            self.ser.close()\n\n# 사용 예제\nif __name__ == \"__main__\":\n    controller = RobotSpeedController(port='/dev/ttyUSB0')\n    controller.run(duration=60)"]]}]}]},{"timestamp":1789307609292,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":243,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"pyprj\"\n"]]}]}]},{"timestamp":1789307627856,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":243,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]},{"type":"edited","filename":"main.py","patch":[{"start1":53,"length1":1986,"diffs":[[1,""]]}]}]},{"timestamp":1789307732815,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.py","patch":[{"start1":1788,"length1":9,"diffs":[[1,"    # 3. 부드러운 속도 변화\n    actual_velocity = smooth_velocity_change(target_velocity)\n    \n    # 4. 모터에 속도 적용\n    apply_motor_speed(actual_velocity)\n    \n    # 5. LED 디스플레이에 상태 표시\n    display.scroll(str(actual_velocity))\n    \n    # 100ms 대기\n    sleep(100)"]]}]}]},{"timestamp":1789308568514,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.py","patch":[{"start1":634,"length1":3,"diffs":[[1,"    \n    # 가속도 비율 계산\n    if accel_value > max_accel:\n        accel_ratio = 100\n    else:\n        accel_ratio = (acc